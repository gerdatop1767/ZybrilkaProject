# Copy to infra/.env on the VPS. Never commit the real file — compose
# reads it automatically because it lives next to docker-compose.yml.
# See docs/DEPLOYMENT.md for the full production runbook.

# Postgres — used both to start the postgres container and to build
# DATABASE_URL for api/worker/migrate inside docker-compose.yml.
POSTGRES_DB=zybrilka
POSTGRES_USER=zybrilka
POSTGRES_PASSWORD=change-me-to-a-real-secret

# Shown by GET /health and in logs — set to the deployed commit/tag.
APP_VERSION=prod
